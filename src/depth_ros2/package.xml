<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>depth_ros2</name>
  <version>0.0.0</version>
  <description>Monocular depth estimation using HYDEN-MoGe_v2 (metric point model)</description>
  <maintainer email="nils.treuheit@ovgu.de">nils</maintainer>
  <license>FAIR-NC</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>model_registry</exec_depend>
</package>
